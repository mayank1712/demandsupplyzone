# Copy this file to .env and fill in your values.

# dhan (your broker)  or  yahoo (free, for testing without a token)
DATA_PROVIDER=dhan

# From web.dhan.co -> My Profile -> Access DhanHQ APIs
# The access token expires every 24 hours - paste a new one each day.
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Blueprint: 10,000 capital, 0.5% risk per trade, 1:5 reward
CAPITAL=10000
RISK_PCT=0.5
REWARD_RATIO=5
